# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
build/
out/

# Tauri / Cargo
src-tauri/target/
src-tauri/gen/
src-tauri/Cargo.lock.bak
**/*.rs.bk

# Vite cache
.vite/
*.local

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# Claude Code per-user state
.claude/

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# Test / coverage
coverage/
.nyc_output/

# Logs
*.log
logs/
npm-debug.log*
pnpm-debug.log*

# Env files (never commit)
.env
.env.local
.env.*.local

# Generated TS bindings (committed, but gitignore staging)
src/ipc/bindings.ts.tmp

# Installer outputs
installers/windows/*.exe
installers/windows/*.msi
installers/macos/*.dmg
installers/macos/*.pkg

# Fetched at packaging time by scripts/fetch-sumatrapdf.{ps1,sh}; never committed
src-tauri/resources/sumatrapdf/*
!src-tauri/resources/sumatrapdf/README.md

# Where scripts/build-shell-ext.ps1 used to put the DLL; never committed
src-tauri/windows/*.dll

# Local MCP browser-tool residue (screenshots, snapshots, console logs)
.playwright-mcp/
# Built by scripts/build-shell-ext.ps1 at packaging time; never committed.
src-tauri/resources/shellext/*
!src-tauri/resources/shellext/README.md
