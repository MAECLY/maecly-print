// Resource script for shell_ext_win.dll.
//
// Numeric constants are spelled out instead of #include <winresrc.h> so the
// script compiles with a bare rc.exe / llvm-rc and no SDK include path.

#define RT_MANIFEST                         24
// winuser.h: the manifest consulted when an activation context is created for
// a DLL (CREATEPROCESS_MANIFEST_RESOURCE_ID = 1 is the *executable* slot).
#define ISOLATIONAWARE_MANIFEST_RESOURCE_ID 2

ISOLATIONAWARE_MANIFEST_RESOURCE_ID RT_MANIFEST "shellext.manifest"

#define VS_VERSION_INFO   1
#define VOS_NT_WINDOWS32  0x00040004L
#define VFT_DLL           0x00000002L
#define VFT2_UNKNOWN      0x00000000L

VS_VERSION_INFO VERSIONINFO
  FILEVERSION     0,0,1,0
  PRODUCTVERSION  0,0,1,0
  FILEFLAGSMASK   0x3fL
  FILEFLAGS       0x0L
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_DLL
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Maecly"
      VALUE "FileDescription",  "Pluryprint Explorer context menu"
      VALUE "FileVersion",      "0.0.1.0"
      VALUE "InternalName",     "shell_ext_win"
      VALUE "LegalCopyright",   "AGPL-3.0-only"
      VALUE "OriginalFilename", "shell_ext_win.dll"
      VALUE "ProductName",      "Pluryprint"
      VALUE "ProductVersion",   "0.0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
